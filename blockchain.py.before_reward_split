import hashlib
import json
import time
import os
from security_shield import IntrusionDetectionSystem as IDS

class SecureBlock:
    def __init__(self, index, previous_hash, transactions, timestamp=None, nonce=0):
        self.index = index
        self.previous_hash = previous_hash
        self.transactions = transactions
        self.timestamp = timestamp if timestamp else time.time()
        self.nonce = nonce
        self.hash = self.calculate_hash()

    def calculate_hash(self):
        block_string = json.dumps({
            "index": self.index,
            "previous_hash": self.previous_hash,
            "transactions": self.transactions,
            "timestamp": self.timestamp,
            "nonce": self.nonce
        }, sort_keys=True).encode()
        return hashlib.sha256(block_string).hexdigest()

    def to_dict(self):
        """Block ko JSON friendly dictionary me convert karta hai"""
        return {
            "index": self.index,
            "previous_hash": self.previous_hash,
            "transactions": self.transactions,
            "timestamp": self.timestamp,
            "nonce": self.nonce,
            "hash": self.hash
        }


class Blockchain:
    def __init__(self):
        self.chain = []
        self.pending_transactions = []
        self.difficulty = 4
        self.mining_reward = 50
        self.DB_FILE = "blockchain_data.json"

        # Initial Boot Up Check: Kya pehle se koi save data hai?
        self.load_chain_from_disk()

    def create_genesis_block(self):
        genesis_block = SecureBlock(0, "0", [{"sender": "SYSTEM", "receiver": "GENESIS", "amount": 0}])
        self.mine_block(genesis_block)
        self.chain.append(genesis_block)
        self.save_chain_to_disk() # Disk par commit karein

    def mine_block(self, block):
        target = '0' * self.difficulty
        while not block.hash.startswith(target):
            block.nonce += 1
            block.hash = block.calculate_hash()
        return block

    def add_transaction_to_mempool(self, transaction, sender_public_key, signature_check_passed):
        if not signature_check_passed:
            print("❌ Security Alert: Rejected unverified transaction from entering Mempool!")
            return False
        self.pending_transactions.append(transaction)
        print(f"📥 Transaction added to Mempool! Pending Queue Size: {len(self.pending_transactions)}")
        return True

    def mine_pending_transactions(self, miner_reward_address):
        if not self.pending_transactions:
            print("⚠️ Mempool is empty. Nothing to mine!")
            return False

        reward_tx = {
            "sender": "SYSTEM_REWARD",
            "receiver": miner_reward_address,
            "amount": self.mining_reward
        }

        block_transactions = list(self.pending_transactions) + [reward_tx]
        previous_block = self.chain[-1]

        new_block = SecureBlock(
            index=len(self.chain),
            previous_hash=previous_block.hash,
            transactions=block_transactions
        )

        self.mine_block(new_block)
        self.chain.append(new_block)
        self.pending_transactions = []

        # DEFENSIVE OPERATION: Mined data ko disk par save karein aur signature block update karein
        self.save_chain_to_disk()
        return True

    def save_chain_to_disk(self):
        """Permanent Ledger Commit: Data ko safely file me dump karta hai"""
        chain_data = [block.to_dict() for block in self.chain]
        with open(self.DB_FILE, "w") as f:
            json.dump(chain_data, f, indent=4)

        # IDS Security Shield ko batao ki yeh authorized change hai
        IDS.register_file_state(self.DB_FILE)

    def load_chain_from_disk(self):
        """Secure Boot Engine: Database se purani chain load karta hai"""
        if not os.path.exists(self.DB_FILE):
            print("⚠️ No blockchain ledger found on disk. Initializing new network...")
            self.create_genesis_block()
            return

        # ANTIVIRUS SHIELD SCRIPT SCAN
        # Agar kisi hacker ne file me 1 zero ya alphabet badla hoga, toh program yhin safe lock ho jayega
        if not IDS.scan_system_integrity(self.DB_FILE):
            return

        try:
            with open(self.DB_FILE, "r") as f:
                raw_chain = json.load(f)

            self.chain = []
            for block_dict in raw_chain:
                block = SecureBlock(
                    index=block_dict["index"],
                    previous_hash=block_dict["previous_hash"],
                    transactions=block_dict["transactions"],
                    timestamp=block_dict["timestamp"],
                    nonce=block_dict["nonce"]
                )
                block.hash = block_dict["hash"] # Load saved hash directly
                self.chain.append(block)

            print(f"💾 [DATABASE] Successfully loaded {len(self.chain)} blocks from storage data history.")

            # Ek baar load hone ke baad live validations loop check karein
            if not self.is_chain_valid():
                print("❌ [CRITICAL] Loaded chain failed runtime verification! System Halted.")
                import sys
                sys.exit(1)

        except Exception as e:
            print(f"❌ Error loading blockchain ledger: {e}")
            self.create_genesis_block()

    def is_chain_valid(self):
        for i in range(1, len(self.chain)):
            current = self.chain[i]
            previous = self.chain[i-1]
            if current.hash != current.calculate_hash():
                return False
            if current.previous_hash != previous.hash:
                return False
            if not current.hash.startswith('0' * self.difficulty):
                return False
        return True

